# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)

aws_region    = "ap-south-1"
key_name      = "nexops-key"          # must already exist in this region
instance_type = "t3.xlarge"

# Your own address. Required — the variable validation rejects 0.0.0.0/0.
#   terraform apply -var="allowed_ssh_cidr=$(curl -s ifconfig.me)/32"
allowed_ssh_cidr = "203.0.113.42/32"

root_volume_size = 100
environment      = "training"
