# =====================================================================
# NexOps - copy to .env before running docker compose
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials; the pipeline reads
# them from the Jenkins credentials store and Kubernetes Secrets instead.
# =====================================================================

# ---- Database ----
POSTGRES_DB=nexops
POSTGRES_USER=nexops
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# ---- Cache ----
REDIS_PORT=6379

# ---- Application ----
NODE_ENV=development
LOG_LEVEL=info
BACKEND_PORT=4000
FRONTEND_PORT=80
CORS_ORIGIN=http://localhost,http://localhost:5173,http://nexops.local

# ---- Auth ----
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_EXPIRES_IN=8h

# Demo login seeded on first start. Change both before any shared environment.
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ---- Images ----
# Your Docker Hub account. Images publish as
#   <DOCKERHUB_USERNAME>/nexops-backend:<IMAGE_TAG>
DOCKERHUB_USERNAME=haritejarv
IMAGE_TAG=local

# ---- Observability (leave empty until the stacks are installed) ----
# Set these and the Monitoring/Logs pages switch from stored samples to live
# PromQL and LogQL. Inside the cluster the values are:
#   PROMETHEUS_URL=http://prometheus-server.monitoring.svc.cluster.local
#   LOKI_URL=http://loki.logging.svc.cluster.local:3100
PROMETHEUS_URL=
LOKI_URL=