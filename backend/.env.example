# ---- NexOps backend configuration (copy to .env, never commit .env) ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://nexops:nexops_dev_password@localhost:5432/nexops
PGSSL=false

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=30

# Auth - MUST be replaced in every real environment
JWT_SECRET=change-me-in-every-environment
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Seed bootstrap admin (dev/demo only; seeding is skipped when SEED_ENABLED=false)
SEED_ENABLED=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost,http://nexops.local

# Optional live observability backends. When unset the matching API returns
# data from PostgreSQL and clearly reports source="database".
PROMETHEUS_URL=
LOKI_URL=
